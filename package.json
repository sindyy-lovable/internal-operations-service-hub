{
  "name": "internal-operations-service-hub",
  "version": "0.0.1",
  "private": true,
"scripts": {
  "build:api": "nest build",
  "build:ui": "parcel build public/index.html --dist-dir dist/frontend --public-url /",
  "build": "npm run build:api && npm run build:ui",
  "start": "nest start",
  "start:dev": "nest start --watch",
  "start:prod": "node dist/main.js",
  "start:ui": "parcel public/index.html",
  "test": "jest --runInBand",
  "test:watch": "jest --watch",
  "test:cov": "jest --coverage",
"eval:ai": "ts-node src/ai-intake/ai-intake.eval.ts",
"release:check": "npm test && npm run build && npm run eval:ai"
},
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^11.0.0",
    "dotenv": "^18.0.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "parcel": "^2.12.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
